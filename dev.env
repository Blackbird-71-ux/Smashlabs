# Local Development Environment
NODE_ENV=development
PORT=5000

# Database (You can use MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://admin:password123@cluster0.mongodb.net/smashlabs-dev?retryWrites=true&w=majority

# Authentication
JWT_SECRET=super-secret-jwt-key-for-local-development-only
API_SECRET_KEY=api-secret-key-for-local-development

# Email Service (Optional for local dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Client URLs
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Redis (if you want to test caching)
REDIS_URL=redis://localhost:6379 