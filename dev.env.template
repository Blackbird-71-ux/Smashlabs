# Local Development Environment Template
# Copy this file to dev.env and fill in your actual credentials

NODE_ENV=development
PORT=5000

# Database (You can use MongoDB Atlas or local MongoDB)
# Get your connection string from MongoDB Atlas dashboard
# Replace the placeholder below with your actual MongoDB connection string
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING

# Authentication
# Generate a secure JWT secret (min 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters
API_SECRET_KEY=your-api-secret-key-for-service-to-service-calls

# Email Service (Optional for local dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_ADDRESS
EMAIL_PASS=YOUR_EMAIL_APP_PASSWORD

# Client URLs
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Redis (if you want to test caching)
REDIS_URL=redis://localhost:6379 